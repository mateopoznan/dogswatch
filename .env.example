# Pies Watch: copy to .env, or run ./install.sh which writes it for you.
# After the first start most of these can be changed in the panel (Settings);
# once saved there, the panel's values win over this file.

# Port of the panel on this computer.
PORT=1717
# Panel language: pl or en.
LANGUAGE=pl
TZ=Europe/Warsaw
PLACE_NAME=

# Sound source: none, dahua, url or microphone.
SOURCE_TYPE=none
# For url: any address FFmpeg can read, e.g. rtsp://192.168.1.10:554/stream1
SOURCE_URL=
SOURCE_USER=
SOURCE_PASSWORD=
# For dahua:
DAHUA_HOST=
DAHUA_RTSP_PORT=554
DAHUA_CHANNEL=1
DAHUA_SUBTYPE=0
# For microphone (Linux only, also set COMPOSE_FILE below):
ALSA_DEVICE=default
# COMPOSE_FILE=docker-compose.yml:docker-compose.mic.yml

# Detection
AUDIO_THRESHOLD=0.008
YAMNET_BARK_THRESHOLD=0.30
YAMNET_BARK_HIGH_THRESHOLD=0.55
MIN_EVENT_SECONDS=1.2
PRE_ROLL_SECONDS=3
MERGE_GAP_SECONDS=15
BARK_PADDING_SECONDS=3
MAX_CANDIDATE_SECONDS=1800
MIN_EVENT_BLOCK_SECONDS=3
RETENTION_DAYS=30

# Login is best turned on in the panel (Settings, Access) or with
#   docker compose exec -T pies-watch python app.py --set-login USER
# Set to 1 only if a reverse proxy in front of the panel already handles login.
ALLOW_PROXY_WITHOUT_LOGIN=0
